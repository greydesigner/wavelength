{% comment %}
  Self-hosted brand fonts (Fraunces + Inter), downloaded from Google Fonts and served
  from this theme's own assets (Latin subset only, variable-weight files) — no external
  font requests at runtime. Each is a single variable-font file; font-weight ranges below
  let the browser interpolate the exact weight requested rather than needing one file per cut.
{% endcomment %}

@font-face {
  font-family: 'Fraunces';
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url({{ 'fraunces-variable.woff2' | asset_url }}) format('woff2');
}

@font-face {
  font-family: 'Fraunces';
  font-style: italic;
  font-weight: 400;
  font-display: swap;
  src: url({{ 'fraunces-italic-variable.woff2' | asset_url }}) format('woff2');
}

@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url({{ 'inter-variable.woff2' | asset_url }}) format('woff2');
}
