{% style %}
  :root {
    {% # Brand typefaces — fixed, self-hosted (see assets/fonts.css.liquid) %}
    --font-heading--family: 'Fraunces', Georgia, serif;
    --font-body--family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

    {% # Layout %}
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --style-border-radius-buttons: {{ settings.button_corner_radius }}px;

    {% # Type scale multipliers, applied by sections/snippets to their base clamp() sizes %}
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
  }

  {% # One .color-{scheme-id} block per scheme defined in the color_scheme_group setting. %}
  {% # Colors are emitted as R, G, B triples so callers can compose rgb()/rgba() with opacity. %}
  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }};
      --color-background-alt: {{ scheme.settings.background_alt.red }}, {{ scheme.settings.background_alt.green }}, {{ scheme.settings.background_alt.blue }};
      --color-text: {{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }};
      --color-text-muted: {{ scheme.settings.text_muted.red }}, {{ scheme.settings.text_muted.green }}, {{ scheme.settings.text_muted.blue }};
      --color-accent: {{ scheme.settings.accent.red }}, {{ scheme.settings.accent.green }}, {{ scheme.settings.accent.blue }};
      --color-accent-text: {{ scheme.settings.accent_text.red }}, {{ scheme.settings.accent_text.green }}, {{ scheme.settings.accent_text.blue }};
      --color-inverse-background: {{ scheme.settings.inverse_background.red }}, {{ scheme.settings.inverse_background.green }}, {{ scheme.settings.inverse_background.blue }};
      --color-inverse-text: {{ scheme.settings.inverse_text.red }}, {{ scheme.settings.inverse_text.green }}, {{ scheme.settings.inverse_text.blue }};
      --color-border: {{ scheme.settings.border.red }}, {{ scheme.settings.border.green }}, {{ scheme.settings.border.blue }};
      background-color: rgb(var(--color-background));
      color: rgb(var(--color-text));
    }
  {% endfor %}
{% endstyle %}
