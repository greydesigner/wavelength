{{ 'section-tonewood-explorer.css' | asset_url | stylesheet_tag }}

{% liquid
  assign first_block = nil
  for block in section.blocks
    if block.type == 'wood'
      assign first_block = block
      break
    endif
  endfor
%}

<section class="tonewood color-{{ section.settings.color_scheme }}" id="tonewood-{{ section.id }}">
  <div class="wrap">
    <div class="section-head">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow-sm">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    <div class="tw-layout">
      <div class="tw-swatches" data-tonewood-swatches>
        {% assign wood_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'wood' %}
            {% assign wood_index = wood_index | plus: 1 %}
            <button
              type="button"
              class="tw-swatch{% if wood_index == 1 %} active{% endif %}"
              data-name="{{ block.settings.name | escape }}"
              data-desc="{{ block.settings.description | escape }}"
              data-warmth="{{ block.settings.warmth }}"
              data-bright="{{ block.settings.brightness }}"
              data-proj="{{ block.settings.projection }}"
              data-sustain="{{ block.settings.sustain }}"
              {{ block.shopify_attributes }}
            >
              <div class="chip" style="background: linear-gradient(135deg, {{ block.settings.color_start }}, {{ block.settings.color_end }});"></div>
              <div class="name">{{ block.settings.name }}</div>
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="tw-panel">
        <div class="kicker">{{ 'general.tone_profile' | t }}</div>
        <h3 data-tonewood-name>{{ first_block.settings.name }}</h3>
        <p data-tonewood-desc>{{ first_block.settings.description }}</p>
        <div class="tw-meter">
          <div class="mrow"><span>{{ 'general.warmth' | t }}</span></div>
          <div class="track"><div class="fill" data-tonewood-fill="warmth" style="width: {{ first_block.settings.warmth }}%;"></div></div>
        </div>
        <div class="tw-meter">
          <div class="mrow"><span>{{ 'general.brightness' | t }}</span></div>
          <div class="track"><div class="fill" data-tonewood-fill="bright" style="width: {{ first_block.settings.brightness }}%;"></div></div>
        </div>
        <div class="tw-meter">
          <div class="mrow"><span>{{ 'general.projection' | t }}</span></div>
          <div class="track"><div class="fill" data-tonewood-fill="proj" style="width: {{ first_block.settings.projection }}%;"></div></div>
        </div>
        <div class="tw-meter">
          <div class="mrow"><span>{{ 'general.sustain' | t }}</span></div>
          <div class="track"><div class="fill" data-tonewood-fill="sustain" style="width: {{ first_block.settings.sustain }}%;"></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('tonewood-{{ section.id }}');
  if (!root) return;
  var swatches = root.querySelectorAll('.tw-swatch');
  swatches.forEach(function (btn) {
    btn.addEventListener('click', function () {
      swatches.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      root.querySelector('[data-tonewood-name]').textContent = btn.getAttribute('data-name');
      root.querySelector('[data-tonewood-desc]').textContent = btn.getAttribute('data-desc');
      root.querySelector('[data-tonewood-fill="warmth"]').style.width = btn.getAttribute('data-warmth') + '%';
      root.querySelector('[data-tonewood-fill="bright"]').style.width = btn.getAttribute('data-bright') + '%';
      root.querySelector('[data-tonewood-fill="proj"]').style.width = btn.getAttribute('data-proj') + '%';
      root.querySelector('[data-tonewood-fill="sustain"]').style.width = btn.getAttribute('data-sustain') + '%';
    });
  });
})();
</script>

{% schema %}
{
  "name": "t:general.tonewood_explorer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Choose Your Wood"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The Tonewood Explorer"
    }
  ],
  "blocks": [
    {
      "type": "wood",
      "name": "t:general.tonewood",
      "settings": [
        { "type": "text", "id": "name", "label": "t:labels.name" },
        { "type": "textarea", "id": "description", "label": "t:labels.description" },
        { "type": "color", "id": "color_start", "label": "t:labels.color_start", "default": "#c3a875" },
        { "type": "color", "id": "color_end", "label": "t:labels.color_end", "default": "#e4cf9d" },
        { "type": "range", "id": "warmth", "label": "t:labels.warmth", "min": 0, "max": 100, "step": 5, "default": 50 },
        { "type": "range", "id": "brightness", "label": "t:labels.brightness", "min": 0, "max": 100, "step": 5, "default": 50 },
        { "type": "range", "id": "projection", "label": "t:labels.projection", "min": 0, "max": 100, "step": 5, "default": 50 },
        { "type": "range", "id": "sustain", "label": "t:labels.sustain", "min": 0, "max": 100, "step": 5, "default": 50 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:general.tonewood_explorer",
      "blocks": [
        { "type": "wood", "settings": { "name": "Sitka Spruce", "description": "Bright, powerful, and wide-ranging dynamically — the standard top wood for players who dig in hard.", "color_start": "#c3a875", "color_end": "#e4cf9d", "warmth": 40, "brightness": 85, "projection": 90, "sustain": 70 } },
        { "type": "wood", "settings": { "name": "Western Red Cedar", "description": "Warmer and more immediately responsive than spruce, especially played quietly.", "color_start": "#b8763e", "color_end": "#d99a5f", "warmth": 70, "brightness": 55, "projection": 65, "sustain": 60 } },
        { "type": "wood", "settings": { "name": "Honduran Mahogany", "description": "Dry, woody, midrange-forward — a longtime favorite for fingerstyle players.", "color_start": "#6b3d2a", "color_end": "#8a5237", "warmth": 80, "brightness": 35, "projection": 55, "sustain": 50 } },
        { "type": "wood", "settings": { "name": "Indian Rosewood", "description": "Deep low end and shimmering overtones, with sustain that keeps blooming after the note.", "color_start": "#3c1f1a", "color_end": "#5a2e26", "warmth": 65, "brightness": 60, "projection": 75, "sustain": 85 } },
        { "type": "wood", "settings": { "name": "Claro Walnut", "description": "Sits tonally between mahogany and rosewood — balanced, articulate, and versatile.", "color_start": "#4a3527", "color_end": "#6e4d38", "warmth": 60, "brightness": 65, "projection": 70, "sustain": 65 } },
        { "type": "wood", "settings": { "name": "Hawaiian Koa", "description": "Bright and glassy when new, growing warmer and more complex for decades as it ages.", "color_start": "#8a5a2e", "color_end": "#b8834c", "warmth": 55, "brightness": 70, "projection": 60, "sustain": 55 } }
      ]
    }
  ]
}
{% endschema %}
