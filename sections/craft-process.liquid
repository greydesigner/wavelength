{{ 'section-craft-process.css' | asset_url | stylesheet_tag }}

<section class="craft-process color-{{ section.settings.color_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow-sm">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'step' %}
        {% assign is_reverse = forloop.index0 | modulo: 2 %}
        <div class="process-row{% if is_reverse == 1 %} reverse{% endif %}" {{ block.shopify_attributes }}>
          <div class="photo{% if block.settings.image %} has-img{% endif %}"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 900 }});"{% endif %}>
            {% unless block.settings.image %}
              <span class="cap">{{ block.settings.heading }}</span>
            {% endunless %}
          </div>
          <div class="text">
            {% if block.settings.step_label != blank %}
              <span class="step">{{ block.settings.step_label }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p>{{ block.settings.body }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.craft_process",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The Process"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From tree to tone"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.process_step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "t:labels.step_label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:labels.body"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "t:general.craft_process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_label": "STEP ONE",
            "heading": "Selecting the wood",
            "body": "Every top starts as a single board, tapped and listened to before it's ever cut. We're listening for stiffness, for resonance, for the wood's own voice — the instrument's tone is decided here, months before assembly begins."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "STEP TWO",
            "heading": "Shaping by hand",
            "body": "Braces are carved and tuned by ear, not machine. The body is bent, glued, and clamped using techniques that haven't changed much in a century — because they still work better than anything faster."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_label": "STEP THREE",
            "heading": "The final finish",
            "body": "A thin, hand-rubbed finish that lets the wood keep breathing. Every instrument is strung, set up, and played by the luthier who built it before it's ever offered for sale."
          }
        }
      ]
    }
  ]
}
{% endschema %}
