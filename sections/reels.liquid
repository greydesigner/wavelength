{{ 'section-reels.css' | asset_url | stylesheet_tag }}

<section class="reels color-{{ section.settings.color_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow-sm">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p>{{ section.settings.subtext }}</p>
      {% endif %}
    </div>
    <div class="reel-grid">
      {% for block in section.blocks %}
        {% if block.type == 'reel' %}
          <a
            class="reel-card"
            href="{{ block.settings.link | default: '#' }}"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            <div class="photo reel-photo{% if block.settings.image %} has-img{% endif %}"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 500 }});"{% endif %}>
              {% unless block.settings.image %}
                <span class="cap">{{ block.settings.caption }}</span>
              {% endunless %}
            </div>
            <div class="reel-play">
              <svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8V4z"></path></svg>
            </div>
            {% if block.settings.caption != blank %}
              <div class="reel-meta">{{ block.settings.caption }}</div>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.cta_label != blank %}
      <div class="reel-cta">
        <a href="{{ section.settings.cta_link | default: '#' }}" target="_blank" rel="noopener" class="button button--outline">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.reels",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "@wavelengthinstruments"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Behind the Build"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "t:labels.subtext",
      "default": "Short clips straight from the bench — shaping, bracing, finishing. Tap any reel to watch it on Instagram."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "Follow on Instagram"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.button_link"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "t:general.reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:labels.caption"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:general.reels",
      "blocks": [
        { "type": "reel", "settings": { "caption": "Bracing the top" } },
        { "type": "reel", "settings": { "caption": "Bending the sides" } },
        { "type": "reel", "settings": { "caption": "Cutting binding" } },
        { "type": "reel", "settings": { "caption": "Hand-rubbing finish" } },
        { "type": "reel", "settings": { "caption": "First note, live" } },
        { "type": "reel", "settings": { "caption": "Tap-testing a top" } }
      ]
    }
  ]
}
{% endschema %}
