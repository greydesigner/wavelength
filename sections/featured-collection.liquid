{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

<section class="featured-collection color-{{ section.settings.color_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow-sm">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
      <div class="grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <a class="card" href="{{ product.url }}">
            <div class="photo{% if product.featured_image %} has-img{% endif %}"{% if product.featured_image %} style="background-image:url({{ product.featured_image | image_url: width: 700 }});"{% endif %}>
              {% unless product.featured_image %}
                <span class="cap">{{ product.title }}</span>
              {% endunless %}
            </div>
            <h4>{{ product.title }}</h4>
            {% if product.type != blank %}
              <div class="sub">{{ product.type }}</div>
            {% endif %}
            <div class="price">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p class="featured-collection__empty">{{ 'general.no_collection_selected' | t }}</p>
    {% endif %}
    {% if section.settings.cta_label != blank and section.settings.collection != blank %}
      <div class="grid-cta">
        <a href="{{ section.settings.collection.url }}" class="button button--dark">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "This Season's Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Currently in the workshop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "View the Full Collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
