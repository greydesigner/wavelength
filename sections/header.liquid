{% liquid
  assign menu = section.settings.menu
%}

<div class="header-wrap color-{{ section.settings.color_scheme }}">
  <header class="site-header">
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: loading: 'eager', widths: '75, 150, 225, 300', style: 'width: ' | append: settings.logo_width | append: 'px;' }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'general.navigation' | t }}">
      {% for link in menu.links %}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="site-header__controls">
      <div class="site-header__actions">
        <a href="{{ routes.search_url }}" class="icon-btn" aria-label="{{ 'search.title' | t }}">
          {{ 'icon-search.svg' | inline_asset_content }}
        </a>

        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ 'customers.login.title' | t }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="{{ 'cart.title' | t }}, {{ cart.item_count }} items">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>

      <button
        type="button"
        class="menu-toggle"
        id="MenuToggle-{{ section.id }}"
        aria-label="{{ 'general.menu' | t }}"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line class="bar bar1" x1="4" y1="7" x2="20" y2="7"></line>
          <line class="bar bar2" x1="4" y1="12" x2="20" y2="12"></line>
          <line class="bar bar3" x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </header>

  <div class="mobile-nav" id="MobileNav-{{ section.id }}">
    {% for link in menu.links %}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {% endfor %}
  </div>
</div>
<div class="nav-backdrop" id="NavBackdrop-{{ section.id }}"></div>

<script>
  (function () {
    var toggle = document.getElementById('MenuToggle-{{ section.id }}');
    var panel = document.getElementById('MobileNav-{{ section.id }}');
    var backdrop = document.getElementById('NavBackdrop-{{ section.id }}');
    if (!toggle || !panel) return;

    function closeMenu() {
      panel.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', function () {
      var isOpen = panel.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (backdrop) backdrop.classList.toggle('open', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    if (backdrop) backdrop.addEventListener('click', closeMenu);
    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1300) closeMenu();
    });
  })();
</script>

{% stylesheet %}
  .header-wrap {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid rgb(var(--color-border));
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 24px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 22px var(--page-margin);
    position: relative;
  }

  .site-header__logo {
    font-family: var(--font-heading--family);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.02em;
    justify-self: start;
    white-space: nowrap;
  }
  .site-header__logo img {
    display: block;
    height: auto;
  }

  .site-header__nav {
    display: flex;
    gap: 22px;
    font-size: 13.5px;
    letter-spacing: 0.02em;
    justify-self: center;
  }
  .site-header__nav a {
    color: rgb(var(--color-text-muted));
    transition: color 0.15s;
    white-space: nowrap;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] {
    color: rgb(var(--color-accent));
  }

  .site-header__controls {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: rgb(var(--color-text-muted));
    transition: background 0.15s, color 0.15s;
  }
  .icon-btn:hover {
    background: rgb(var(--color-background-alt));
  }
  .icon-btn svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    background: rgb(var(--color-text));
    color: rgb(var(--color-background));
    border-radius: 50%;
    font-size: 9.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: rgb(var(--color-text));
    transition: background 0.15s;
  }
  .menu-toggle:hover {
    background: rgb(var(--color-background-alt));
  }
  .menu-toggle svg {
    width: 21px;
    height: 21px;
  }
  .menu-toggle .bar {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle.open .bar1 { transform: translateY(5px) rotate(45deg); }
  .menu-toggle.open .bar2 { opacity: 0; }
  .menu-toggle.open .bar3 { transform: translateY(-5px) rotate(-45deg); }

  .mobile-nav {
    display: none;
    flex-direction: column;
    border-bottom: 1px solid rgb(var(--color-border));
    padding: 6px var(--page-margin) 22px;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - 100%);
    overflow-y: auto;
    box-shadow: 0 16px 32px rgba(20, 14, 8, 0.14);
    background: rgb(var(--color-background));
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav a {
    padding: 14px 0;
    border-bottom: 1px solid rgb(var(--color-border));
    font-size: 15px;
    color: rgb(var(--color-text-muted));
    font-family: var(--font-body--family);
  }
  .mobile-nav a:last-child { border-bottom: none; }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(20, 14, 8, 0.35);
    z-index: 90;
  }
  .nav-backdrop.open { display: block; }

  @media (max-width: 1300px) {
    .site-header__nav { display: none; }
    .menu-toggle { display: flex; }
  }
  @media (min-width: 1301px) {
    .mobile-nav { display: none !important; }
  }
  @media (max-width: 640px) {
    .site-header { padding-left: 20px; padding-right: 20px; }
    .mobile-nav { padding-left: 20px; padding-right: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
