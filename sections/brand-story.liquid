{{ 'section-brand-story.css' | asset_url | stylesheet_tag }}

<section class="brand-story color-{{ section.settings.color_scheme }}">
  <div class="wrap">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow-sm">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="brand-story__body">{{ section.settings.body }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.brand_story",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The Wavelength Workshop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Built by hand, one instrument at a time"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body",
      "default": "<p>For eighteen years, our workshop has built acoustic instruments the slow way — selecting wood by ear, shaping each body by hand, and setting up every instrument ourselves before it ships. No two boards of wood are the same, so no two instruments are either. We build roughly forty a year. That's on purpose.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.brand_story"
    }
  ]
}
{% endschema %}
